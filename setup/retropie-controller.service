[Unit]
Description=RetroPie Browser Controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/retropie-controller
ExecStart=/home/pi/retropie-controller/retropie-controller-arm
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
